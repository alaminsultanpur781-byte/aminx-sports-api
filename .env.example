PORT=3000
NODE_ENV=production
# Paste the Render PostgreSQL Internal Database URL here in the Web Service environment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional: set to require only when connecting with an External Database URL.
# PGSSLMODE=require
PG_POOL_MAX=5
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "require('bcryptjs').hash('YourStrongPassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE
# Optional licensed sports data provider credentials; keep secrets on server only.
SPORTS_DATA_API_KEY=
